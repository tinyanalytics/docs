{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "tinyanalytics",
  "description": "Learn how to understand traffic and product behavior without analytics cookies using tinyanalytics: web and product analytics, AI discovery, revenue, experiments, monitoring, and API access.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "author": "tinyanalytics",
      "og:site_name": "tinyanalytics documentation",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "theme-color": "#006420"
    },
    "organization": {
      "name": "tinyanalytics"
    }
  },
  "colors": {
    "primary": "#006420",
    "light": "#009B32",
    "dark": "#009B32"
  },
  "fonts": {
    "family": "Inter"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/rollup",
      "destination": "/organization-overview"
    },
    {
      "source": "/guides/rollup",
      "destination": "/organization-overview"
    },
    {
      "source": "/guides",
      "destination": "/"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/:slug*"
    }
  ],
